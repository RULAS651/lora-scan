# ============================================================
# LoRA Scan Privacy Platform — Environment Template
# Copy this file to `.env` and fill in real values.
# ============================================================

# -----------------------------
# Database (PostgreSQL via Prisma)
# -----------------------------
# NOT sqlite: the schema uses enums, a scalar list and JSON-ish columns, none of
# which Prisma's sqlite connector supports. `docker compose up -d db` starts a
# local Postgres matching this URL.
DATABASE_URL="postgresql://loras:loras@localhost:5432/lorascan?schema=public"

# -----------------------------
# Authentication
# -----------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-64-byte-random-hex-string-please-change-me-in-prod"
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# -----------------------------
# Encryption (AES-256-GCM)
# -----------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEEP THIS SAFE.  If lost, all member LoRAs + scans are unrecoverable.
ENCRYPTION_KEY="replace-with-32-byte-base64-key-change-in-prod"
# Optional: previous key during zero-downtime rotation
# ENCRYPTION_KEY_PREVIOUS=""

# -----------------------------
# ComfyUI (your existing instance)
# -----------------------------
COMFYUI_URL="http://127.0.0.1:8188"
# Optional path to your existing LoRA-training workflow JSON (exported from ComfyUI API format)
# COMFYUI_WORKFLOW_TEMPLATE="./workflows/lora_train_workflow_api.json"

# -----------------------------
# RunPod (serverless GPU training)
# -----------------------------
RUNPOD_API_KEY=""
RUNPOD_ENDPOINT_ID=""
# Endpoint running the `photo_qc` handler (InsightFace). Falls back to
# RUNPOD_ENDPOINT_ID when unset. This is the only face check that matches what
# the trainer sees -- see FACE_DETECTOR below.
RUNPOD_QC_ENDPOINT_ID=""
# Public URL of this backend so RunPod can call us back
RUNPOD_WEBHOOK_BASE_URL="https://your-domain.example.com"

# -----------------------------
# Member / Admin
# -----------------------------
# Comma-separated emails that get admin role on first register
ADMIN_EMAILS="admin@example.com"
# Max scan images per session. The shot plan is 25; a video import adds more on
# top, so this has to clear both.
SCAN_MAX_IMAGES_PER_SESSION=60
# Max file size per image upload (MB)
SCAN_MAX_FILE_SIZE_MB=8
# Hours to retain raw scans AFTER training succeeds before auto-deletion
SCAN_TTL_AFTER_TRAIN_HOURS=24
# Hours to retain raw scans if training FAILS (retry window)
SCAN_TTL_AFTER_FAIL_HOURS=72

# -----------------------------
# Network
# -----------------------------
BACKEND_PORT=4000
FRONTEND_PORT=3000
CORS_ORIGIN="http://localhost:3000"

# -----------------------------
# Face scan QC
# -----------------------------
# Which detector judges framing:
#   auto   (default) runpod when configured, else human, else none
#   runpod authoritative -- the same InsightFace stack the trainer loads
#   human  local CPU via the optional @vladmandic/human dependency
#   none   no detection; every photo reports "unchecked" rather than passing
FACE_DETECTOR="auto"

# Framing thresholds. The defaults are measured against a real InsightFace
# stack; change them only with a reason.
#
# QC_MAX_FACE_AREA is the important one. A face filling more than ~45% of the
# frame AREA makes RetinaFace-family detectors return ZERO faces, which means
# no embedding, which means a LoRA of a stranger -- and nothing errors along
# the way. Raising this ceiling re-opens that failure.
QC_MAX_FACE_AREA=0.45
QC_MIN_FACE_AREA=0.005
QC_MIN_EDGE_MARGIN=0.02
QC_MIN_DIMENSION=512
QC_MIN_FACE_PX=160
# 0 = do not gate on face pixel size. Raise only if your trainer does NOT add a
# full-resolution face crop per photo.
QC_MIN_STRONG=0
# Usable photos needed before a set may be trained.
QC_MIN_USABLE=15
QC_IDEAL_TOTAL=25

# -----------------------------
# Video shoot
# -----------------------------
# ffmpeg-static ships a binary; set this only to use a system ffmpeg instead.
# FFMPEG_PATH=""
SCAN_MAX_VIDEO_SIZE_MB=200
# Photos accepted per dry-run QC call.
SCAN_QC_MAX_FILES=60
