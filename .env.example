# ============================================================
# LoRA Scan Privacy Platform — Environment Template
# Copy this file to `.env` and fill in real values.
# ============================================================

# -----------------------------
# Database (SQLite via Prisma)
# -----------------------------
DATABASE_URL="file:./dev.db"

# -----------------------------
# Authentication
# -----------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-64-byte-random-hex-string-please-change-me-in-prod"
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# -----------------------------
# Encryption (AES-256-GCM)
# -----------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEEP THIS SAFE.  If lost, all member LoRAs + scans are unrecoverable.
ENCRYPTION_KEY="replace-with-32-byte-base64-key-change-in-prod"
# Optional: previous key during zero-downtime rotation
# ENCRYPTION_KEY_PREVIOUS=""

# -----------------------------
# ComfyUI (your existing instance)
# -----------------------------
COMFYUI_URL="http://127.0.0.1:8188"
# Optional path to your existing LoRA-training workflow JSON (exported from ComfyUI API format)
# COMFYUI_WORKFLOW_TEMPLATE="./workflows/lora_train_workflow_api.json"

# -----------------------------
# RunPod (serverless GPU training)
# -----------------------------
RUNPOD_API_KEY=""
RUNPOD_ENDPOINT_ID=""
# Public URL of this backend so RunPod can call us back
RUNPOD_WEBHOOK_BASE_URL="https://your-domain.example.com"

# -----------------------------
# Member / Admin
# -----------------------------
# Comma-separated emails that get admin role on first register
ADMIN_EMAILS="admin@example.com"
# Max scan images per session (5 mandatory angles + extras)
SCAN_MAX_IMAGES_PER_SESSION=15
# Max file size per image upload (MB)
SCAN_MAX_FILE_SIZE_MB=8
# Hours to retain raw scans AFTER training succeeds before auto-deletion
SCAN_TTL_AFTER_TRAIN_HOURS=24
# Hours to retain raw scans if training FAILS (retry window)
SCAN_TTL_AFTER_FAIL_HOURS=72

# -----------------------------
# Network
# -----------------------------
BACKEND_PORT=4000
FRONTEND_PORT=3000
CORS_ORIGIN="http://localhost:3000"
